---
const SITE = "https://dennisgarcia.dev";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <title>Page not found | Dennis García</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <style is:inline>
      html, body {
        margin: 0;
        min-height: 100%;
        background: #161616;
        color: #f2f2f2;
        font-family: system-ui, -apple-system, "IBM Plex Sans", sans-serif;
      }
      .wrap {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 24px;
        gap: 8px;
      }
      .logo {
        width: 180px;
        max-width: 60vw;
        height: auto;
        margin-bottom: 8px;
      }
      h1 { font-size: 3rem; margin: 0; }
      p { color: #b8b8b8; max-width: 34ch; line-height: 1.5; }
      a.home {
        margin-top: 16px;
        color: #161616;
        background: #f2f2f2;
        padding: 12px 22px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
      }
      .es { color: #8a8a8a; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <img
        src="/assets/dennis-logo-white.png"
        alt="Dennis García"
        class="logo"
      />
      <h1>404</h1>
      <p>
        That page doesn't exist, or it moved. Head back home and pick a path
        from there.
      </p>
      <p class="es" lang="es">
        Esa página no existe o se movió. Vuelve al inicio y sigue desde ahí.
      </p>
      <a class="home" href={SITE + "/"}>Go home / Ir al inicio</a>
    </div>
  </body>
</html>
