---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import type { Lang } from "../i18n/ui";
import "../styles/styles.css";

interface Props {
  lang: Lang;
  selectedItem: string;
  title: string;
  description?: string;
}

const { lang, selectedItem, title, description } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang={lang}>
  <Header title={title} description={description} lang={lang} />
  <body>
    <div class="content">
      <Sidebar selectedItem={selectedItem} lang={lang} />
      <nav class="main">
        <div class="container">
          <slot />
        </div>
      </nav>
    </div>
  </body>
</html>
