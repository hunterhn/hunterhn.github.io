---
import { ViewTransitions } from "astro:transitions";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/utils";

interface HeaderProps {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props as HeaderProps;

const base = Astro.site ? Astro.site.origin.replace(/\/$/, "") : "";
const stripped = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";

const canonical = `${base}${localizePath(stripped, lang)}`;
const esUrl = `${base}${localizePath(stripped, "es")}`;
const enUrl = `${base}${localizePath(stripped, "en")}`;

const desc = description || t(lang, "meta.description");
const ogLocale = lang === "en" ? "en_US" : "es_ES";
---

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Dennis García" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />

  <!-- Canonical (self-referential) + language alternates -->
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={esUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Dennis García" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={lang === "en" ? "es_ES" : "en_US"} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <ViewTransitions />
  <link href="https://fonts.googleapis.com/" rel="preconnect" />
  <link href="https://fonts.gstatic.com/" rel="preconnect" crossorigin="anonymous" />
  <!--[if lt IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js" type="text/javascript"></script><![endif]-->
  <script is:inline>
    !(function (o, c) {
      var n = c.documentElement,
        t = " w-mod-";
      (n.className += t + "js"),
        ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) &&
          (n.className += t + "touch");
    })(window, document);
  </script>
  <script is:inline>
    (function () {
      try {
        var path = window.location.pathname;
        var isEn = path === "/en" || path.indexOf("/en/") === 0;
        var stored = localStorage.getItem("lang");
        var pref;
        if (stored === "en" || stored === "es") {
          pref = stored;
        } else {
          var nav = (navigator.language || navigator.userLanguage || "es").toLowerCase();
          pref = nav.indexOf("en") === 0 ? "en" : "es";
        }
        var target = null;
        if (pref === "en" && !isEn) {
          target = "/en" + (path === "/" ? "/" : path);
        } else if (pref === "es" && isEn) {
          target = path.replace(/^\/en/, "") || "/";
        }
        if (target && target !== path) {
          window.location.replace(target);
        }
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    document.addEventListener("click", function (event) {
      var el = event.target && event.target.closest ? event.target.closest("[data-lang-toggle]") : null;
      if (!el) return;
      try {
        localStorage.setItem("lang", el.getAttribute("data-lang-toggle"));
      } catch (e) {}
    });
  </script>
  <script is:inline>
    // Email protection: assemble the mailto only on click.
    document.addEventListener("click", function (event) {
      var el =
        event.target && event.target.closest
          ? event.target.closest("[data-email]")
          : null;
      if (!el) return;
      event.preventDefault();
      try {
        var address = atob(el.getAttribute("data-email"));
        window.location.href = "mailto:" + address;
      } catch (e) {}
    });
  </script>
</head>
