---
import { ViewTransitions } from "astro:transitions";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/utils";
import JsonLd from "./JsonLd.astro";
import { buildJsonLd } from "../data/schema";

interface HeaderProps {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props as HeaderProps;

const base = Astro.site ? Astro.site.origin.replace(/\/$/, "") : "";
const stripped = Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/";

const canonical = `${base}${localizePath(stripped, lang)}`;
const esUrl = `${base}${localizePath(stripped, "es")}`;
const enUrl = `${base}${localizePath(stripped, "en")}`;

const desc = description || t(lang, "meta.description");
const ogLocale = lang === "en" ? "en_US" : "es_ES";

const jsonLd = buildJsonLd({
  lang,
  canonical,
  isHome: stripped === "/",
  pageTitle: title,
});
---

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="color-scheme" content="dark" />
  <style is:inline>
    html {
      background-color: #161616;
      color-scheme: dark;
    }
  </style>
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Dennis García" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />

  <!-- Canonical (self-referential) + language alternates -->
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />

  <JsonLd data={jsonLd} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Dennis García" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={lang === "en" ? "es_ES" : "en_US"} />
  <meta property="og:image" content={`${base}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Dennis García, DevOps and Cloud Architect" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={`${base}/og-image.png`} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#161616" />
  <ViewTransitions />
  <link href="https://fonts.googleapis.com/" rel="preconnect" />
  <link href="https://fonts.gstatic.com/" rel="preconnect" crossorigin="anonymous" />
  <!--[if lt IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js" type="text/javascript"></script><![endif]-->
  <script is:inline>
    !(function (o, c) {
      var n = c.documentElement,
        t = " w-mod-";
      (n.className += t + "js"),
        ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) &&
          (n.className += t + "touch");
    })(window, document);
  </script>
  <script is:inline>
    (function () {
      try {
        var path = window.location.pathname;
        var isEs = path === "/es" || path.indexOf("/es/") === 0;
        var stored = localStorage.getItem("lang");
        if (stored !== "en" && stored !== "es") return;
        var target = null;
        if (stored === "es" && !isEs) {
          target = "/es" + (path === "/" ? "/" : path);
        } else if (stored === "en" && isEs) {
          target = path.replace(/^\/es/, "") || "/";
        }
        if (target && target !== path) {
          window.location.replace(target);
        }
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    document.addEventListener("click", function (event) {
      var el = event.target && event.target.closest ? event.target.closest("[data-lang-toggle]") : null;
      if (!el) return;
      try {
        localStorage.setItem("lang", el.getAttribute("data-lang-toggle"));
      } catch (e) {}
    });
  </script>
  <script is:inline>
    // Email protection: assemble the mailto only on click.
    document.addEventListener("click", function (event) {
      var el =
        event.target && event.target.closest
          ? event.target.closest("[data-email]")
          : null;
      if (!el) return;
      event.preventDefault();
      try {
        var address = atob(el.getAttribute("data-email"));
        window.location.href = "mailto:" + address;
      } catch (e) {}
    });
  </script>
</head>
