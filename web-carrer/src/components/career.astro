---
import { Icon } from 'astro-icon/components';
import CareerCard from './career-card.astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { getCareerItems } from '../data/portfolio-view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const careerData = getCareerItems(lang);

const badgeLabels: Record<string, string> = {
  work: t(lang, 'career.type.work'),
  education: t(lang, 'career.type.education'),
  volunteer: t(lang, 'career.type.volunteer'),
};

const getItemMeta = (type: string) => {
  if (type === 'education') return { icon: 'mdi:school', category: 'education' };
  if (type === 'volunteer') return { icon: 'mdi:hand-heart', category: 'volunteering' };
  return { icon: 'mdi:briefcase', category: 'work' };
};
---

<section id="career" class="section-container max-w-6xl mx-auto overflow-hidden">
  <div class="container mx-auto reveal-content" style="animation-delay: 1000ms;">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> {t(lang, 'career.title')}
        </h2>
        <p class="text-subtext font-body text-sm max-w-md">{t(lang, 'career.subtitle')}</p>
      </div>

      <div class="flex gap-2 flex-wrap shrink-0">
        <button class="career-filter-btn active" data-filter="all">{t(lang, 'career.filterAll')}</button>
        <button class="career-filter-btn" data-filter="work">
          <Icon name="mdi:briefcase" class="w-3 h-3" /> {t(lang, 'career.filterWork')}
        </button>
        <button class="career-filter-btn" data-filter="education">
          <Icon name="mdi:school" class="w-3 h-3" /> {t(lang, 'career.filterEducation')}
        </button>
        <button class="career-filter-btn" data-filter="volunteering">
          <Icon name="mdi:hand-heart" class="w-3 h-3" /> {t(lang, 'career.filterVolunteering')}
        </button>
      </div>
    </div>

    <div class="relative">
      <div class="absolute left-[13px] md:left-1/2 md:-translate-x-1/2 top-1 bottom-0 w-0.5 bg-linear-to-b from-accent via-white/10 to-transparent"></div>

      <!-- Mobile View -->
      <div class="md:hidden space-y-8">
        {careerData.map((item, index) => {
          const { icon, category } = getItemMeta(item.type);
          return (
            <div class="scroll-stat relative pl-9" data-category={category}>
              <div class="absolute left-0 top-0 z-10">
                <div class={`w-7 h-7 rounded-full border-2 flex items-center justify-center transition-all duration-300 ${index === 0 ? 'bg-accent border-accent animate-outer-glow' : 'bg-background border-accent/40'}`}>
                  <Icon name={icon} class={`w-4 h-4 ${index === 0 ? 'text-background' : 'text-accent/70'}`} />
                </div>
              </div>
              <div class="absolute left-7 top-3.5 w-2 h-px bg-accent/40"></div>
              <CareerCard item={item} variant="mobile" badgeLabel={badgeLabels[item.type]} />
            </div>
          );
        })}
      </div>

      <!-- Desktop View -->
      <div class="hidden md:block space-y-4">
        {careerData.map((item, index) => {
          const { icon, category } = getItemMeta(item.type);
          return (
            <div class="scroll-stat relative grid grid-cols-2" data-category={category}>
              <div class="absolute left-1/2 -translate-x-1/2 top-0 z-10">
                <div class={`w-7 h-7 rounded-full border-2 flex items-center justify-center transition-all duration-300 ${index === 0 ? 'bg-accent border-accent animate-outer-glow' : 'bg-background border-accent/40'}`}>
                  <Icon name={icon} class={`w-4 h-4 ${index === 0 ? 'text-background' : 'text-accent/70'}`} />
                </div>
              </div>
              <div class="md:px-6 md:py-0 relative">
                {index % 2 === 0 && <div class="hidden md:block absolute right-0 top-[14px] w-6 h-px bg-accent/40"></div>}
                {index % 2 === 0 ? <CareerCard item={item} variant="desktop-left" badgeLabel={badgeLabels[item.type]} /> : <div class="h-full pointer-events-none"></div>}
              </div>
              <div class="md:px-6 md:py-0 relative">
                {index % 2 !== 0 && <div class="hidden md:block absolute left-0 top-[14px] w-6 h-px bg-accent/40"></div>}
                {index % 2 !== 0 ? <CareerCard item={item} variant="desktop-right" badgeLabel={badgeLabels[item.type]} /> : <div class="h-full pointer-events-none"></div>}
              </div>
            </div>
          );
        })}
      </div>

      <div id="see-more-overlay" class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-background via-background/90 to-transparent flex items-end justify-center pb-4 z-20 hidden">
        <button id="see-more-btn" class="career-filter-btn px-6 py-2.5 bg-background shadow-[0_0_20px_rgba(0,0,0,0.5)]">
          <Icon name="mdi:chevron-down" class="w-4 h-4" /> {t(lang, 'career.seeMore')}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  @keyframes revealIn { to { opacity: 1; transform: translateY(0); } }
  @keyframes outer-glow {
    0%, 100% { box-shadow: 0 0 10px var(--color-accent); }
    50% { box-shadow: 0 0 25px var(--color-accent), 0 0 15px var(--color-accent); }
  }
  .animate-outer-glow { animation: outer-glow 2.5s ease-in-out infinite; }
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .scroll-stat.reveal { opacity: 1; transform: translateY(0) scale(1); }
  .scroll-stat.filtered-out, .scroll-stat.hidden-by-limit { display: none !important; }
  .scroll-stat.blurred-out { opacity: 0.5 !important; filter: blur(2px); pointer-events: none; user-select: none; }
  .career-filter-btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-family: var(--font-body); font-size: 0.625rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; padding: 0.3rem 0.8rem;
    border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: color-mix(in srgb, var(--color-accent) 65%, transparent);
    background: transparent; cursor: pointer; transition: all 0.2s ease;
  }
  .career-filter-btn:hover {
    border-color: var(--color-accent); color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .career-filter-btn.active {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-color: var(--color-accent); color: var(--color-accent);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    const cardIndexMap = new Map<Element, number>();
    cards.forEach((card, i) => cardIndexMap.set(card, i));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = cardIndexMap.get(entry.target) ?? 0;
          setTimeout(() => entry.target.classList.add('reveal'), (index % 2) * 150);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10px 0px' });
    cards.forEach((card) => observer.observe(card));
  }

  function initListLogic() {
    const filterBtns = document.querySelectorAll('.career-filter-btn[data-filter]');
    const seeMoreBtn = document.getElementById('see-more-btn');
    const overlay = document.getElementById('see-more-overlay');
    const careerItemsMobile = document.querySelectorAll('.md\\:hidden .scroll-stat');
    const careerItemsDesktop = document.querySelectorAll('.hidden.md\\:block .scroll-stat');
    const LIMIT = 4;
    let currentFilter = 'all';
    let isExpanded = false;

    function updateView() {
      let totalMatching = 0;
      [careerItemsMobile, careerItemsDesktop].forEach((list) => {
        let visibleCount = 0;
        list.forEach((item) => {
          const category = (item as HTMLElement).dataset.category ?? '';
          const matchesFilter = currentFilter === 'all' || category === currentFilter;
          item.classList.remove('filtered-out', 'hidden-by-limit', 'blurred-out');
          if (!matchesFilter) {
            item.classList.add('filtered-out');
          } else {
            visibleCount++;
            if (!isExpanded) {
              if (visibleCount === LIMIT + 1) item.classList.add('blurred-out');
              else if (visibleCount > LIMIT + 1) item.classList.add('hidden-by-limit');
            }
          }
        });
        if (list === careerItemsMobile) totalMatching = visibleCount;
      });
      filterBtns.forEach((btn) => {
        if ((btn as HTMLElement).dataset.filter === currentFilter) btn.classList.add('active');
        else btn.classList.remove('active');
      });
      if (overlay) overlay.style.display = totalMatching > LIMIT && !isExpanded ? 'flex' : 'none';
      revealCards();
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = (btn as HTMLElement).dataset.filter ?? 'all';
        isExpanded = false;
        updateView();
      });
    });
    if (seeMoreBtn) {
      seeMoreBtn.addEventListener('click', () => {
        isExpanded = true;
        updateView();
      });
    }
    updateView();
  }

  revealCards();
  initListLogic();
  document.addEventListener('astro:after-swap', () => {
    revealCards();
    initListLogic();
  });
</script>
