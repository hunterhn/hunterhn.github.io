---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../utils/images';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { getHome } from '../data/portfolio-view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const data = getHome(lang);
const { name, jobTitle, location, availability, descriptionHtml, socials, photoUrl } = data;
const profileImage = await resolveAssetImage(photoUrl);
---

<section id="home" class="flex flex-col items-center justify-center section-container md:pt-30 gap-1 min-h-[80vh] text-center">
  <div class="relative group mb-2 reveal-content" style="animation-delay: 100ms;">
    <div class="balloon-float w-24 h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)]">
      {profileImage ? (
        <Image
          src={profileImage}
          alt={name}
          width={400}
          height={400}
          class="w-full h-full object-cover scale-110"
          loading="eager"
        />
      ) : (
        <img
          src="/placeholder.jpeg"
          alt={name}
          class="w-full h-full object-cover scale-110"
          loading="eager"
        />
      )}
    </div>
    <div class="balloon-float absolute -z-10 top-0 left-0 w-full h-full bg-accent rounded-full blur-[80px] opacity-20"></div>
  </div>

  <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body font-light text-gray leading-relaxed">{t(lang, 'home.greeting')}</p>
  </div>

  <div class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content" style="animation-delay: 300ms;">
    <h1 class="text-5xl md:text-7xl font-heading font-bold text-maintext tracking-tight">
      {name}
    </h1>
    <div class="font-mono text-sm text-accent/80 uppercase tracking-[0.2em] mt-4 flex items-center justify-center gap-3">
      {jobTitle}
    </div>
    <div class="flex items-center justify-center gap-4 mt-2 flex-wrap">
      <span class="inline-flex items-center gap-1 text-xs text-subtext">
        <Icon name="mdi:map-marker" class="w-3.5 h-3.5 text-accent/60" />
        {location}
      </span>
      {availability && (
        <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
          <span class="relative flex w-2 h-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full w-2 h-2 bg-emerald-400"></span>
          </span>
          {availability}
        </span>
      )}
    </div>
    <p class="text-gray font-body text-lg leading-relaxed mt-6" set:html={descriptionHtml} />
  </div>

  <div class="mt-8 mb-4 reveal-content" style="animation-delay: 400ms;">
    <a
      href="#contact"
      class="group relative inline-flex items-center justify-center px-10 py-2 bg-white/5 border border-white/10 rounded-full text-maintext font-body transition-all duration-300 border-accent/50 bg-accent/10 shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] hover:scale-105"
    >
      <span class="tracking-wide text-sm md:text-base font-medium">{t(lang, 'home.cta')}</span>
      <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
    </a>
  </div>

  <div class="flex gap-6 mt-4 mb-8 reveal-content" style="animation-delay: 500ms;">
    {socials.filter((social) => social.emailB64 || (social.url && social.url !== '#')).map((social) => (
      <a
        href={social.emailB64 ? '#' : social.url}
        data-email={social.emailB64}
        target={social.emailB64 ? undefined : '_blank'}
        rel={social.emailB64 ? undefined : 'noopener noreferrer'}
        class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
      >
        <Icon name={social.icon} class="w-8 h-8 text-maintext group-hover:text-accent transition-colors duration-300" />
        <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
          {social.name}
        </span>
      </a>
    ))}
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  @keyframes revealIn {
    to { opacity: 1; transform: translateY(0); }
  }
  .avatar-container {
    animation: float 5s ease-in-out infinite alternate, wobble 7s ease-in-out infinite alternate;
  }
  .balloon-float { animation: floating-balloon 8s ease-in-out infinite; }
  @keyframes floating-balloon {
    0% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(3px, -8px) rotate(1deg); }
    66% { transform: translate(-3px, -4px) rotate(-1deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }
</style>
