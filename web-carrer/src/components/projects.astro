---
import ProjectCard from './project-card.astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { getProjects } from '../data/portfolio-view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const projectsData = getProjects(lang);
---

<section id="projects" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-16 project-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> {t(lang, 'projects.title')}
      </h2>
      <p class="text-subtext font-body text-sm max-w-md">{t(lang, 'projects.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsData.map((project) => <ProjectCard project={project} viewLabel={t(lang, 'projects.view')} />)}
    </div>
  </div>
</section>

<style>
  .project-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-card {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-header.reveal,
  .project-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  const initProjectReveal = () => {
    const header = document.querySelector('.project-header');
    const cards = document.querySelectorAll('.project-card');
    const cardIndexMap = new Map<Element, number>();
    cards.forEach((card, i) => cardIndexMap.set(card, i));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          if (target.classList.contains('project-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } else if (target.classList.contains('project-card')) {
            const index = cardIndexMap.get(target) ?? 0;
            setTimeout(() => target.classList.add('reveal'), (index % 3) * 150);
            observer.unobserve(target);
          }
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10px 0px' });

    if (header) observer.observe(header);
    cards.forEach((card) => observer.observe(card));
  };

  window.addEventListener('load', initProjectReveal);
  document.addEventListener('astro:after-swap', initProjectReveal);
</script>
