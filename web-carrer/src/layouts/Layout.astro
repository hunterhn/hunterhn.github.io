---
import '../styles/global.css';
import ThemeScript from '../components/theme-script.astro';
import type { Lang } from '../i18n/ui';

interface Social {
  name: string;
  url: string;
  icon?: string;
  showInContact?: boolean;
}

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  siteUrl?: string;
  ogImageUrl?: string;
  twitterHandle?: string;
  personName?: string;
  jobTitle?: string;
  lang?: Lang;
  socials?: Social[];
}

const {
  title,
  description = '',
  keywords = '',
  siteUrl = '',
  ogImageUrl = '/placeholder.jpeg',
  twitterHandle = '',
  personName = '',
  jobTitle = '',
  lang = 'es',
  socials = [],
} = Astro.props;

const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const esPath = '/';
const enPath = '/en/';
const currentPath = lang === 'es' ? esPath : enPath;

const resolvedSiteUrl = siteUrl || Astro.site?.toString() || '';
const canonicalUrl = resolvedSiteUrl
  ? resolvedSiteUrl.replace(/\/$/, '') + currentPath
  : Astro.url.href;
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, resolvedSiteUrl || Astro.url.origin).href
  : '';

const sameAsUrls = socials
  .filter((s) => s.url && s.url !== '#' && s.url !== '')
  .map((s) => s.url);

const siteName = personName || title;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: siteName,
      alternateName: [siteName, title],
      url: canonicalUrl,
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl}#person`,
      name: siteName,
      ...(jobTitle ? { jobTitle } : {}),
      ...(canonicalUrl ? { url: canonicalUrl } : {}),
      ...(ogImage ? { image: ogImage } : {}),
      ...(description ? { description } : {}),
      ...(sameAsUrls.length ? { sameAs: sameAsUrls } : {}),
    },
  ],
};

const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>

    <!-- PRIMARY META -->
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {personName && <meta name="author" content={personName} />}
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={`${resolvedSiteUrl.replace(/\/$/, '')}${esPath}`} />
    <link rel="alternate" hreflang="en" href={`${resolvedSiteUrl.replace(/\/$/, '')}${enPath}`} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${resolvedSiteUrl.replace(/\/$/, '')}${esPath}`}
    />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={personName || title} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`${personName || title} portfolio preview`} />

    <!-- TWITTER CARD -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {twitterHandle && <meta name="twitter:site" content={`@${twitterHandle.replace(/^@/, '')}`} />}

    <!-- JSON-LD STRUCTURED DATA -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- LANGUAGE DETECTION -->
    <script is:inline>
      (function () {
        try {
          var path = window.location.pathname;
          var isEn = path.indexOf('/en') === 0;
          var stored = localStorage.getItem('lang');
          var pref;
          if (stored === 'en' || stored === 'es') {
            pref = stored;
          } else {
            var nav = (navigator.language || navigator.userLanguage || 'es').toLowerCase();
            pref = nav.indexOf('en') === 0 ? 'en' : 'es';
          }
          if (pref === 'en' && !isEn) {
            window.location.replace('/en/');
          } else if (pref === 'es' && isEn) {
            window.location.replace('/');
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      document.addEventListener('click', function (event) {
        var el =
          event.target && event.target.closest
            ? event.target.closest('[data-lang-toggle]')
            : null;
        if (!el) return;
        try {
          localStorage.setItem('lang', el.getAttribute('data-lang-toggle'));
        } catch (e) {}
      });
    </script>
    <script is:inline>
      // Email protection: assemble the mailto only on click.
      document.addEventListener('click', function (event) {
        var el =
          event.target && event.target.closest
            ? event.target.closest('[data-email]')
            : null;
        if (!el) return;
        event.preventDefault();
        try {
          var address = atob(el.getAttribute('data-email'));
          window.location.href = 'mailto:' + address;
        } catch (e) {}
      });
    </script>

    <!-- THEME SCRIPT & STATUS BAR COLOR -->
    <ThemeScript />
  </head>
  <body class="bg-container relative min-h-screen overflow-x-hidden antialiased">
    <div
      id="matrix-container"
      class="fixed top-0 left-0 w-full h-full -z-10 pointer-events-none"
      style="mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 100%);"
    >
    </div>

    <main class="px-2 sm:px-12 md:px-14 lg:px-28 max-w-360 mx-auto relative z-0">
      <slot />
    </main>

    <button
      id="to-top"
      class="fixed bottom-8 right-8 z-50 p-0 rounded-full bg-background border border-accent/10 shadow-2xl transition-all duration-500 translate-y-20 opacity-0 group flex items-center justify-center cursor-pointer"
      aria-label="Back to top"
    >
      <svg class="w-14 h-14 -rotate-90">
        <circle cx="28" cy="28" r="24" fill="none" stroke="currentColor" stroke-width="3" class="text-accent/5"></circle>
        <circle
          id="progress-circle"
          cx="28"
          cy="28"
          r="24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-dasharray="150.7"
          stroke-dashoffset="150.7"
          stroke-linecap="round"
          class="text-accent transition-all duration-100"></circle>
      </svg>
      <div class="absolute text-accent group-hover:scale-110 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M13.0001 7.82843V20H11.0001V7.82843L5.63614 13.1924L4.22192 11.7782L12.0001 4L19.7783 11.7782L18.3641 13.1924L13.0001 7.82843Z"></path>
        </svg>
      </div>
    </button>

    <script>
      import { initMatrixRain } from '../utils/matrix-rain';
      import { setupScrollToTop } from '../utils/scroll-to-top';

      function initLayoutScripts() {
        initMatrixRain();
        setupScrollToTop();
      }

      initLayoutScripts();
      document.addEventListener('astro:after-swap', initLayoutScripts);
    </script>
  </body>
</html>
